{
  "openapi": "3.1.0",
  "info": {
    "title": "Broodline API",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://api.broodline.example"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateAccountResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "integer"
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "balances": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        },
        "required": [
          "accountId",
          "playerId",
          "serverId",
          "accessToken",
          "refreshToken",
          "balances"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {}
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreateAccountRequest": {
        "type": "object",
        "properties": {
          "birthdateBand": {
            "type": "string",
            "example": "adult"
          },
          "storefrontRegion": {
            "type": "string",
            "example": "us-central1"
          }
        },
        "required": [
          "birthdateBand",
          "storefrontRegion"
        ]
      },
      "SyncResponse": {
        "type": "object",
        "properties": {
          "player": {
            "type": "object",
            "properties": {
              "playerId": {
                "type": "string",
                "format": "uuid"
              },
              "serverId": {
                "type": "integer"
              }
            },
            "required": [
              "playerId",
              "serverId"
            ]
          },
          "balances": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "campaign": {
            "type": "object",
            "properties": {
              "highestWaveCleared": {
                "type": "integer"
              },
              "milestonesClaimed": {
                "type": "integer"
              }
            },
            "required": [
              "highestWaveCleared",
              "milestonesClaimed"
            ]
          },
          "timers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "completesAt": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "completesAt"
              ]
            }
          },
          "config": {
            "type": "object",
            "properties": {
              "bundleVersion": {
                "type": "string"
              },
              "minimumClientVersion": {
                "type": "string"
              },
              "tabs": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "waves": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "reward": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "currency",
                        "amount"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "reward"
                  ]
                }
              },
              "traits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "species": {
                      "type": "string"
                    },
                    "counters": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "species",
                    "counters"
                  ]
                }
              }
            },
            "required": [
              "bundleVersion",
              "minimumClientVersion",
              "tabs",
              "waves",
              "traits"
            ]
          },
          "ftue": {
            "type": "object",
            "properties": {
              "founderNamed": {
                "type": "boolean"
              },
              "tutorialStockGranted": {
                "type": "boolean"
              },
              "splices": {
                "type": "integer"
              }
            },
            "required": [
              "founderNamed",
              "tutorialStockGranted",
              "splices"
            ]
          }
        },
        "required": [
          "player",
          "balances",
          "campaign",
          "timers",
          "config",
          "ftue"
        ]
      },
      "DeleteAccountResponse": {
        "type": "object",
