          "creatures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatureDto"
            }
          },
          "balance": {
            "type": "integer"
          }
        },
        "required": [
          "slot",
          "shards",
          "creatures",
          "balance"
        ]
      },
      "NodeClaimRequest": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer"
          }
        },
        "required": [
          "slot"
        ]
      },
      "CombatOutcomeDto": {
        "type": "object",
        "properties": {
          "trait": {
            "type": "string"
          },
          "tier": {
            "type": [
              "integer",
              "null"
            ]
          },
          "p": {
            "type": "number"
          }
        },
        "required": [
          "trait",
          "tier",
          "p"
        ]
      },
      "SpliceForecast": {
        "type": "object",
        "properties": {
          "combat2": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CombatOutcomeDto"
            }
          },
          "instinct": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instinct": {
                  "type": "string"
                },
                "p": {
                  "type": "number"
                }
              },
              "required": [
