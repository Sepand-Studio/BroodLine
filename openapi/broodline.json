            ]
          },
          "slot": {
            "type": "string",
            "enum": [
              "trait_1",
              "trait_2"
            ]
          }
        },
        "required": [
          "from",
          "slot"
        ]
      },
      "SplicePreviewRequest": {
        "type": "object",
