          "creatureId": {
            "type": "string",
            "format": "uuid"
          },
          "species": {
            "type": "string"
          },
          "generation": {
            "type": "integer"
          },
          "trait1": {
            "type": "string"
          },
          "tier1": {
            "type": [
              "integer",
              "null"
            ]
          },
          "trait2": {
            "type": "string"
          },
          "tier2": {
            "type": [
              "integer",
              "null"
            ]
          },
          "instinct": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
