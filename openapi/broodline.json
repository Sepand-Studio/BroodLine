      },
      "RosterResponse": {
        "type": "object",
        "properties": {
          "creatures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatureDto"
            }
          },
          "cap": {
            "type": "integer"
          }
        },
        "required": [
          "creatures",
          "cap"
        ]
      },
      "NodeClaimResponse": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer"
          },
          "shards": {
