# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.p8
*.keystore
credentials.json
secrets.json

# Dependencies (future tooling)
node_modules/
.pnpm-store/

# Build outputs
/build/
/dist/
/.build/
*.log

# .NET build outputs (engine/ package — dotnet build regenerates these).
# Named bin~/obj~ (not bin/obj) so Unity's Asset Database ignores them too —
# see the comment in engine/Broodline.Sim.csproj.
engine/bin~/
engine/obj~/

# .NET build outputs (tests/ projects — pure .NET, no Unity import concern,
# so these use the standard bin/obj names rather than engine/'s bin~/obj~/).
tests/**/bin/
tests/**/obj/

# .NET build outputs (tools/ projects — same reasoning as tests/ above: pure
# .NET CLIs with no Unity import concern).
tools/**/bin/
tools/**/obj/

# Unity generated
client/[Ll]ibrary/
client/[Tt]emp/
client/[Oo]bj/
client/[Bb]uild/
client/[Bb]uilds/
client/[Ll]ogs/
client/[Uu]serSettings/
client/[Mm]emoryCaptures/
client/[Rr]ecordings/

# Unity regenerates these; the hand-maintained solution is at the repo root
client/*.csproj
client/*.sln
client/*.user

# Benchmark and test output — regenerated, never a source of truth.
# Findings are promoted into the plan document instead.
# The trailing /* rather than / matters: git will not descend into an excluded
# directory, so a negation inside one is never reached.
implementation/results/*

# ...except the sweep CSVs. "Regenerated" is not true of these — reproducing one
# needs a particular physical device, off charge, for half an hour — and they are
# the evidence behind a triangle budget that goes to an artist. 16 KB against
# 3.5 MB of logs.
!implementation/results/*.csv

# ...and the recorded test baselines, for the opposite reason: they ARE
# regenerated, cheaply, and that is exactly why they must be committed. A
# baseline exists to be diffed against a later run by a later phase, and a
# file the phase gate cannot read out of the repo is a file it will replace
# with a number typed into a paragraph - which is how Phase 4's "71" outlived
# the truth (74) unnoticed. A few hundred bytes.
!implementation/results/*-test-baseline.txt

# Xcode / iOS (if used later)
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Android (if used later)
.gradle/
local.properties
**/build/
**/outputs/
*.apk
*.aab

# Playwright / test artifacts (if used later)
playwright-report/
test-results/
coverage/

# Unity Hub created a nested repo here; preserved, not tracked
client/.git.disabled/

# Claude Code worktrees - isolated workspaces, never committed
.claude/worktrees/

# Claude Code permission grants. MACHINE-LOCAL, never shared: settings.json
# was committed once by accident on 2026-09-14 carrying Bash(gcloud:*) and
# Bash(terraform:*), which hands every clone the ability to run any command
# against any cloud project the cloner is authenticated to. A permission grant
# is a property of one developer's machine and trust, not of the repository.
.claude/settings.json
.claude/settings.local.json

# Phase 4 - the TypeScript half
services/**/dist/
services/**/*.tsbuildinfo

# Phase 5 - services/sim, the C# half. Same reasoning as tests/ and tools/
# above: a pure .NET service with no Unity import concern, so standard
# bin/obj names rather than engine/'s bin~/obj~/.
services/**/bin/
services/**/obj/

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars

# Config bundle build output. The AUTHORED json under config/bundles is
# tracked; what the publish step assembles is not.
config/out/

# The local dev stack (services/api/src/dev.ts) publishes its bundle and
# replay objects here. Scratch: delete it and the next start republishes.
.local-stack/

# Brainstorming companion mockups (superpowers). Scratch, like .superpowers/sdd/.
.superpowers/
