# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.p8
*.keystore
credentials.json
secrets.json

# Dependencies (future tooling)
node_modules/
.pnpm-store/

# Build outputs
/build/
/dist/
/.build/
*.log

# .NET build outputs (engine/ package — dotnet build regenerates these).
# Named bin~/obj~ (not bin/obj) so Unity's Asset Database ignores them too —
# see the comment in engine/Broodline.Sim.csproj.
engine/bin~/
engine/obj~/

# .NET build outputs (tests/ projects — pure .NET, no Unity import concern,
# so these use the standard bin/obj names rather than engine/'s bin~/obj~/).
tests/**/bin/
tests/**/obj/

# Unity generated
client/[Ll]ibrary/
client/[Tt]emp/
client/[Oo]bj/
client/[Bb]uild/
client/[Bb]uilds/
client/[Ll]ogs/
client/[Uu]serSettings/
client/[Mm]emoryCaptures/
client/[Rr]ecordings/

# Unity regenerates these; the hand-maintained solution is at the repo root
client/*.csproj
client/*.sln
client/*.user

# Benchmark and test output — regenerated, never a source of truth.
# Findings are promoted into the plan document instead.
implementation/results/

# Xcode / iOS (if used later)
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Android (if used later)
.gradle/
local.properties
**/build/
**/outputs/
*.apk
*.aab

# Playwright / test artifacts (if used later)
playwright-report/
test-results/
coverage/

# Unity Hub created a nested repo here; preserved, not tracked
client/.git.disabled/
