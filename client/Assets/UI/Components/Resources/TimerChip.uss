/* A countdown. bible 10.6 wants tabular figures so it does not jitter as it
 * ticks; no face is imported yet, so this sets the size and weight the
 * handoff specifies and the jitter remains until one is.
 */
.timer-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-sunk);
    /* Half of a MEASURED 35px, rounded down - Theme.uss header item 4.
     * NOT VERIFIED IN THE CORPUS: nothing in client/ composes a TimerChip
     * yet, so no capture renders one and 35px was measured on a chip built
     * alone under a real panel. The height and this radius are coupled; a
     * screen that changes this rule's padding or --text-secondary must
     * re-measure both. */
    border-radius: 17px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
}

.timer-chip__time {
    font-size: var(--text-secondary);
    -unity-font-style: bold;
    color: var(--ink-primary);
}

.timer-chip.expired .timer-chip__time {
    color: var(--coral-text);
}
