<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="CreatureCard.uss" />
    <ui:VisualElement name="silhouette" class="creature-card__silhouette" />
    <ui:VisualElement name="header" class="creature-card__header">
        <ui:Label name="name" class="creature-card__name" />
        <ui:Label name="generation" class="creature-card__generation" />
    </ui:VisualElement>
    <ui:VisualElement name="pips" class="creature-card__pips" />
    <ui:Label name="instinct" class="creature-card__instinct" />
</ui:UXML>
