.creature-card {
    flex-direction: column;
    width: 160px;
    padding: 8px;
    border-radius: 8px;
    background-color: rgba(20, 20, 24, 0.85);
}

.creature-card__silhouette {
    height: 64px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 6px;
}

.creature-card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.creature-card__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
}

.creature-card__generation {
    font-size: 11px;
    color: rgb(180, 180, 190);
}

.creature-card__pips {
    flex-direction: row;
    margin-top: 6px;
}

.creature-card__pips > .trait-pip {
    margin-right: 4px;
}

.creature-card__instinct {
    margin-top: 4px;
    font-size: 10px;
    color: rgb(160, 160, 170);
}

/* bible 3.3: the Founder's name is what stops a player. A visible marker on
 * the card itself is the read that carries into the roster and the splice
 * screen alike. */
.creature-card.founder {
    border-width: 1px;
    border-color: rgb(210, 180, 90);
}

.creature-card.aberrant .creature-card__silhouette {
    background-color: rgba(190, 140, 230, 0.25);
}

.creature-card.committed {
    opacity: 0.7;
}
