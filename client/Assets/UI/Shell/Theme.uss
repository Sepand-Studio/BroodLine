/* The handoff's primitives, as element defaults and a small class vocabulary.
 *
 * APPLIED AT THE PANEL ROOT (Shell.uxml), so a screen gets the register for
 * free and its own stylesheet only has to describe its own layout. That is
 * the opposite of the previous arrangement, where 18 stylesheets each
 * re-specified nothing and the app rendered as untinted boxes on black.
 *
 * THREE THINGS THE HANDOFF ASKS FOR THAT USS CANNOT EXPRESS, and what is
 * done instead. These are deliberate translations, not omissions - read
 * before "fixing" one of them back to the README's literal value.
 *
 * 1. `linear-gradient(180deg, #8878cf, #6f5fbb)` on the primary CTA. UI
 *    Toolkit has no gradient background; `background-image` takes a texture,
 *    not a function. A solid `--violet` sits between the two stops and is
 *    what is used. A gradient would mean shipping a 1xN texture per CTA
 *    colour, which is real art for a difference of six hex steps.
 *
 * 2. `box-shadow`. USS has no box-shadow at all - not on cards, not on the
 *    CTA. Card elevation is therefore carried by the surface/paper contrast
 *    and radius alone, which is why `--surface` is pure white against
 *    `--paper`: on a light theme that contrast IS the elevation.
 *
 * 3. The physical button press, `box-shadow: 0 3px 0 #5b4d9e` collapsing to
 *    `0 1px 0` with `translateY(2px)`. bible 10.6 names this specifically and
 *    says to preserve it, so it is reproduced with the properties USS does
 *    have: a 3px bottom border in `--violet-shadow` that drops to 1px while
 *    the element translates 2px down. Same silhouette, same motion, same
 *    feel under a thumb.
 *
 * FONTS ARE NOT SET HERE. The handoff pairs Baloo 2 (display/numerals) with
 * Nunito (body), both Google Fonts, and neither is in the project - there is
 * no .ttf under client/Assets at all. Sizes, weights and letter-spacing
 * below follow the handoff's type table so the scale is right the moment a
 * face is imported; until then everything renders in Unity's default sans.
 * bible 10.6's two hard requirements - tabular figures and an 11px floor on
 * any number a decision depends on - are a FONT choice and a SIZE choice
 * respectively. The size floor is honoured below (`--text-secondary` is the
 * smallest size used on a numeral); the tabular requirement cannot be met
 * until a face lands, and is the reason to import one.
 */

/* ---------------------------------------------------------------- surfaces */

.shell-root {
    background-color: var(--paper);
}

/* ------------------------------------------------------------------- text */

Label {
    color: var(--ink);
    font-size: var(--text-body);
    -unity-font-style: bold;
}

.t-screen-title {
    font-size: var(--text-screen-title);
    color: var(--ink);
    -unity-font-style: bold;
}

.t-section {
    font-size: var(--text-section);
    color: var(--ink);
    -unity-font-style: bold;
}

.t-hero {
    font-size: var(--text-hero);
    color: var(--ink);
    -unity-font-style: bold;
}

.t-card-title {
    font-size: var(--text-card-title);
    color: var(--ink);
    -unity-font-style: bold;
}

.t-secondary {
    font-size: var(--text-secondary);
    color: var(--mute);
}

/* Uppercase micro label - handoff: 9-10px, 800, letter-spacing .1em, mute. */
.t-micro {
    font-size: var(--text-micro);
    color: var(--mute);
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.t-danger  { color: var(--coral-text); }
.t-success { color: var(--green-text); }
.t-warn    { color: var(--amber-text); }
.t-violet  { color: var(--violet-text); }

/* --------------------------------------------------------------- surfaces */

.card {
    background-color: var(--surface);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    margin-bottom: var(--space-3);
}

.row {
    background-color: var(--surface-sunk);
    border-radius: var(--radius-row);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
}

.panel-violet { background-color: var(--violet-tint); border-radius: var(--radius-row); padding: var(--space-3); }
.panel-teal   { background-color: var(--teal-tint);   border-radius: var(--radius-row); padding: var(--space-3); }
.panel-green  { background-color: var(--green-tint);  border-radius: var(--radius-row); padding: var(--space-3); }
.panel-amber  { background-color: var(--amber-tint);  border-radius: var(--radius-row); padding: var(--space-3); }
.panel-coral  { background-color: var(--coral-tint);  border-radius: var(--radius-row); padding: var(--space-3); }

.divider {
    height: 1px;
    background-color: var(--divider);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
}

/* --------------------------------------------------------------- buttons */

/* Unity's runtime theme gives Button its own border, margin and tinted
 * background. Every one of those is overridden here rather than per screen,
 * because a screen that forgets to do it looks like a different app. */
Button {
    -unity-font-style: bold;
    font-size: var(--text-cta);
    color: #ffffff;
    background-color: var(--violet);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: var(--violet-shadow);
    border-radius: var(--radius-cta);
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    margin-top: var(--space-1);
    margin-bottom: var(--space-1);
    margin-left: 0;
    margin-right: 0;
    transition-property: translate, border-bottom-width, background-color;
    transition-duration: 60ms;
}

/* bible 10.6's physical press. See note 3 in this file's header. */
Button:active {
    translate: 0 2px;
    border-bottom-width: 1px;
    background-color: var(--violet-deep);
}

Button:disabled {
    background-color: var(--hairline);
    color: var(--mute-soft);
    border-bottom-color: var(--hairline);
}

/* Secondary: violet on tint, per the handoff's secondary button. */
.btn-secondary {
    background-color: var(--violet-tint);
    color: var(--violet-text);
    border-bottom-color: #ddd3f0;
}
.btn-secondary:active { background-color: #e7e0f6; }

/* Success and danger CTAs - green-deep and coral-deep per the token table. */
.btn-success { background-color: var(--green); border-bottom-color: var(--green-deep); }
.btn-danger  { background-color: var(--coral); border-bottom-color: var(--coral-deep); }

/* A text-only action: no fill, no drop edge. Used for "skip" and the like. */
.btn-quiet {
    background-color: rgba(0, 0, 0, 0);
    color: var(--mute);
    border-bottom-width: 0;
    font-size: var(--text-body);
}
.btn-quiet:active { translate: 0 0; color: var(--violet-text); }

/* ------------------------------------------------------------ text fields */

TextField {
    margin-top: var(--space-1);
    margin-bottom: var(--space-1);
}

TextField > * {
    background-color: var(--surface);
    border-radius: var(--radius-row);
    border-width: 1px;
    border-color: var(--hairline);
    color: var(--ink);
    font-size: var(--text-card-title);
    padding: 10px;
}

TextField:focus > * {
    border-color: var(--ring);
    border-width: 2px;
}

/* ------------------------------------------------------------------ chips */

.chip {
    background-color: var(--violet-tint);
    color: var(--violet-text);
    border-radius: var(--radius-chip);
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    font-size: var(--text-micro);
    -unity-font-style: bold;
}

.pill {
    border-radius: var(--radius-pill);
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
}

/* Selected / unselected option, from the handoff's exact rule. USS has no
 * inset box-shadow, so the 2px ring is a real border and the 1px hairline is
 * the same border at 1px - the layout cost is identical because both states
 * carry a border, which is why the unselected one is specified at all. */
.option {
    background-color: #f7f5fb;
    border-width: 1px;
    border-color: var(--hairline);
    border-radius: var(--radius-row);
    padding: var(--space-3);
}

.option--selected {
    background-color: var(--surface);
    border-width: 2px;
    border-color: var(--ring);
}
