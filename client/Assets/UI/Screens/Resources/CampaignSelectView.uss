.campaign-select-view {
    flex-direction: column;
    padding: 12px;
}

.campaign-select-view__title {
    font-size: 22px;
    margin-bottom: 8px;
}

.campaign-select-view__waves {
    flex-direction: column;
}

.campaign-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 10px;
    margin-bottom: 6px;
}

.campaign-row:disabled {
    opacity: 0.4;
}
