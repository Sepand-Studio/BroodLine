/* Wave selection. A locked wave is a disabled row, not a hidden one - the
 * campaign's shape should be visible before it is playable. */
.campaign-select-view { flex-direction: column; padding: var(--gutter); }

.campaign-select-view__title {
    font-size: var(--text-screen-title);
    color: var(--ink);
    -unity-font-style: bold;
    margin-bottom: var(--space-3);
}

.campaign-select-view__waves { flex-direction: column; }

.campaign-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: var(--surface);
    border-radius: var(--radius-row);
    border-width: 1px;
    border-color: var(--divider);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
    color: var(--ink);
    font-size: var(--text-card-title);
    border-bottom-width: 1px;
    border-bottom-color: var(--divider);
}

.campaign-row:active { translate: 0 1px; background-color: var(--violet-tint); }

.campaign-row:disabled {
    background-color: var(--surface-sunk);
    color: var(--mute-soft);
    opacity: 1;
}
