<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="PostWaveView.uss" />
    <!-- NO VERDICT COLOUR HERE. This is the one screen that renders both a
         win and a loss, so the colour is Bind's to set - see PostWaveView. -->
    <ui:Label name="headline" class="post-wave-view__headline t-hero" />
    <ui:VisualElement name="stats" class="post-wave-view__stats" />
    <ui:VisualElement name="granted" class="post-wave-view__granted" />
    <ui:Button name="next" class="post-wave-view__next btn-primary" />
</ui:UXML>
