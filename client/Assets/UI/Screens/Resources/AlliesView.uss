.allies { flex-grow: 1; }
.allies__seal {
    width: 84px; height: 84px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--hud-frame);
    border-width: 2px;
    border-color: var(--brass);
    border-radius: 42px;
    margin-bottom: var(--space-2);
}
.allies .allies__pennant {
    width: 50px; height: 50px;
    -unity-background-image-tint-color: var(--brass-light);
}
.allies .allies__banner-kicker {
    color: var(--brass-light);
    font-size: var(--text-micro);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-1);
}
.allies__banner-title {
    color: var(--surface-paper);
    font-size: var(--text-section);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.allies .btn-primary { align-self: flex-start; margin-top: var(--space-3); }
.allies__benefit { flex-direction: row; align-items: center; padding-top: var(--space-2); padding-bottom: var(--space-2); }
.allies__benefit-icon {
    width: 24px; height: 24px;
    margin-right: var(--space-3);
    -unity-background-image-tint-color: var(--violet-text);
}
.allies__benefit-title { color: var(--ink-primary); font-size: var(--text-body); -unity-font-style: bold; }
.allies__benefit-detail { color: var(--ink-secondary); font-size: var(--text-secondary); white-space: normal; }
