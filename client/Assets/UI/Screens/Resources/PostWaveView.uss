.post-wave-view {
    flex-direction: column;
    padding: 12px;
}

.post-wave-view__headline {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
}

.post-wave-view__reward {
    margin-top: 8px;
    color: rgb(240, 215, 140);
}

.post-wave-view__granted {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
}

.post-wave-view__grant {
    margin-right: 8px;
    margin-bottom: 8px;
}

.post-wave-view__next {
    margin-top: 16px;
}
