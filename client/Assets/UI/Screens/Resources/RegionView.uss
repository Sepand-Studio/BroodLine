/* The Ark region detail keeps claims server-backed and adds catalog context. */
.region-view { flex-grow: 1; }

.region-view__hero {
    height: 180px;
    flex-shrink: 0;
    justify-content: flex-end;
    overflow: hidden;
    border-width: 2px;
    border-color: var(--brass);
    border-radius: var(--radius-card);
    background-color: var(--surface-deep);
    -unity-background-scale-mode: scale-and-crop;
    margin-bottom: var(--space-3);
}
.region-view__hero-shade { background-color: rgba(22, 17, 32, 0.82); padding: var(--space-3); }
.region-view__band { color: var(--brass-light); font-size: var(--text-secondary); -unity-font-style: bold; }
.region-view__name { color: var(--surface-paper); font-size: var(--text-screen-title); -unity-font-style: bold; }
.region-view__detail { color: var(--ink-secondary); font-size: var(--text-body); white-space: normal; }

.region-view__stats { flex-direction: row; }

/* A sentence, not a label, so it wraps. The tint, radius and padding are
 * Theme's `.panel-coral` and the ink is `.t-danger`; shown only when it says
 * something - RegionView.CardFor has the measurement. */
.region-view__blocker {
    white-space: normal;
    margin-top: var(--space-2);
}

/* A row action, not a screen CTA, so it sits at the card's trailing edge at
 * its own width rather than stretching. It is NOT `.btn-primary`: three
 * ramped CTAs stacked down a list would each claim to be the screen's one
 * next step. The 12px replaces Theme's 4px Button margin, which is a CTA
 * row's spacing and too tight under a wrapped refusal. */
.region-view__claim {
    align-self: flex-end;
    margin-top: var(--space-3);
}
