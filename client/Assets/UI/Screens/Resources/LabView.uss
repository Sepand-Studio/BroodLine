.lab { flex-grow: 1; }
.lab__core-card .section-card__surface {
    background-color: var(--surface-deep);
    border-color: var(--brass);
}
.lab__core-card .section-card__heading { color: var(--brass-light); }
.lab__core-line { flex-direction: row; align-items: center; }
.lab__core-icon {
    width: 46px; height: 46px;
    margin-right: var(--space-3);
    -unity-background-image-tint-color: var(--brass-light);
}
.lab__core-tier { color: var(--surface-paper); font-size: var(--text-section); -unity-font-style: bold; }
.lab__core-detail { color: var(--surface-paper); font-size: var(--text-secondary); white-space: normal; }
.lab__stage-frame {
    position: relative;
    height: 360px;
    overflow: hidden;
    border-width: 2px;
    border-color: var(--brass);
    border-radius: var(--radius-card);
    background-color: var(--surface-deep);
}
.lab__stage, .lab__hotspots {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}
.lab__stage { -unity-background-scale-mode: scale-and-crop; }
.lab__hotspot {
    position: absolute;
    translate: -50% -50%;
    width: 44px;
    height: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    border-width: 1px;
    border-color: var(--brass);
    border-radius: 22px;
    background-color: var(--hud-frame);
}
.lab__hotspot-icon { width: 25px; height: 25px; -unity-background-image-tint-color: var(--brass-light); }
.lab__hotspot:active { translate: -50% -50%; background-color: var(--hud-frame-edge); }
.lab__stage-hint {
    color: var(--ink-secondary);
    font-size: var(--text-secondary);
    margin-top: var(--space-2);
}
/* Two classes, so this outranks OptionRow.uss's own `padding` shorthand. */
.lab .lab__facility { padding-left: 48px; }
.lab .lab__facility--core { border-color: var(--brass); background-color: var(--surface); }
.lab__facility .lab__glyph {
    position: absolute;
    left: var(--space-3);
    top: 14px;
    width: 24px; height: 24px;
    -unity-background-image-tint-color: var(--violet-text);
}
.lab__facility .lab__timer { align-self: flex-start; margin-top: var(--space-2); }
.lab__inspect {
    align-self: flex-end;
    margin-top: var(--space-2);
    color: var(--violet-text);
    font-size: var(--text-secondary);
    -unity-font-style: bold;
}
.lab__blocker {
    align-self: flex-start;
    background-color: var(--violet-tint);
    color: var(--violet-text);
    border-radius: var(--radius-tile);
    padding-top: 4px; padding-bottom: 4px;
    padding-left: var(--space-2); padding-right: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-secondary);
}
