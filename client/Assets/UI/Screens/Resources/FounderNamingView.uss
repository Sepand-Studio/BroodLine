/* Beat 4. bible 3.3 makes naming optional, so the skip is a quiet action and
 * the confirm is the only CTA on screen. */
.founder-naming-view { flex-direction: column; padding: var(--gutter); }

.founder-naming-view__prompt {
    font-size: var(--text-screen-title);
    color: var(--ink);
    -unity-font-style: bold;
    margin-bottom: var(--space-3);
    white-space: normal;
}

.founder-naming-view__founder {
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--space-4);
}

.founder-naming-view__name { margin-bottom: var(--space-1); }

.founder-naming-view__blocker {
    color: var(--coral-text);
    background-color: var(--coral-tint);
    border-radius: var(--radius-row);
    padding: var(--space-2);
    white-space: normal;
    margin-bottom: var(--space-2);
    font-size: var(--text-body);
}

.founder-naming-view__confirm { margin-top: var(--space-2); }

/* Quiet, not a second CTA: skipping is legitimate and shouldn't compete. */
.founder-naming-view__skip {
    margin-top: var(--space-1);
    background-color: rgba(0, 0, 0, 0);
    color: var(--mute);
    border-bottom-width: 0;
    font-size: var(--text-body);
}
.founder-naming-view__skip:active { translate: 0 0; color: var(--violet-text); }
