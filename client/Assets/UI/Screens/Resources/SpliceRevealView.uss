/* Beat 6 - the payoff. The hybrid is the warm thing on a recessive ground
 * (bible 10.1), so this is the one screen that centres and enlarges. */
.splice-reveal-view { flex-direction: column; padding: var(--gutter); align-items: center; }

.splice-reveal-view__headline {
    font-size: var(--text-hero);
    color: var(--ink);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: var(--space-3);
}

/* A mutation is the rare outcome and the reason the screen exists. Violet is
 * the brand colour and this is where it earns the emphasis. */
.splice-reveal-view.mutated .splice-reveal-view__headline { color: var(--violet-text); }

.splice-reveal-view__child { margin-bottom: var(--space-3); }

.splice-reveal-view__child-line {
    font-size: var(--text-body);
    color: var(--mute);
    white-space: normal;
    margin-bottom: var(--space-1);
}

/* The two consumed parents, still whole. bible 2.1 makes this the FTUE's
 * whole lesson, so they are shown at full strength and the consumption line
 * below carries the fact instead of the parents being greyed out. */
.splice-reveal-view__parents {
    flex-direction: row;
    justify-content: center;
    margin-top: var(--space-3);
}

.splice-reveal-view__parent { margin-left: var(--space-1); margin-right: var(--space-1); }

.splice-reveal-view__consumption {
    margin-top: var(--space-3);
    font-size: var(--text-secondary);
    color: var(--mute);
    white-space: normal;
}

.splice-reveal-view__next { margin-top: var(--space-4); width: 100%; }
