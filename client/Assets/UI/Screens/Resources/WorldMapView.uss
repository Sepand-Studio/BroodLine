.world-map { flex-grow: 1; }
.world-map__region .option-row__title { font-size: var(--text-card-title); }
.world-map__ark-label {
    color: var(--ink-secondary);
    font-size: var(--text-secondary);
    -unity-font-style: bold;
    margin-bottom: var(--space-2);
}
.world-map__viewport {
    position: relative;
    width: 280px;
    height: 280px;
    align-self: center;
    border-radius: var(--radius-card);
    border-width: 2px;
    border-color: var(--brass);
    overflow: hidden;
}
.world-map__atlas {
    position: relative;
    width: 280px;
    height: 280px;
    background-color: var(--surface-sunk);
    -unity-background-scale-mode: scale-and-crop;
}
.world-map__controls {
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--space-2);
}
.world-map__control { min-width: 44px; min-height: 44px; margin-left: var(--space-2); margin-right: var(--space-2); }
.world-map__ring {
    position: absolute;
    border-width: 1px;
    border-color: var(--brass-light);
    border-radius: 140px;
    background-color: rgba(0, 0, 0, 0);
}
.world-map__marker {
    position: absolute;
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    padding: 0;
    margin: 0;
    border-radius: 16px;
    border-width: 2px;
    border-color: var(--brass);
    background-color: var(--surface);
    color: var(--ink-primary);
    font-size: var(--text-card-title);
    -unity-text-align: middle-center;
}
.world-map__marker--route {
    background-color: var(--brass-light);
    border-color: var(--brass);
    color: var(--ink-primary);
}
.world-map__marker--muted { opacity: 0.75; }
.world-map__marker--here {
    background-color: var(--action);
    border-color: var(--action-shadow);
    color: var(--action-text);
}
.world-map__marker--selected {
    border-width: 3px;
    border-color: var(--brass-light);
}
.world-map__marker:active { background-color: var(--violet-pressed); }
.world-map__selection {
    background-color: var(--surface-deep);
    border-width: 1px;
    border-color: var(--brass);
    border-radius: var(--radius-row);
    padding: var(--space-3);
}
.world-map__selected-name {
    color: var(--brass-light);
    font-size: var(--text-section);
    -unity-font-style: bold;
}
.world-map__selected-detail {
    color: var(--surface-paper);
    font-size: var(--text-body);
    white-space: normal;
    margin-top: var(--space-1);
}
.world-map__route-summary {
    color: var(--brass-light);
    font-size: var(--text-secondary);
    -unity-font-style: bold;
    margin-top: var(--space-3);
}
.world-map__route-names {
    color: var(--surface-paper);
    font-size: var(--text-secondary);
    white-space: normal;
    margin-top: var(--space-1);
}
.world-map__selected-action {
    align-self: flex-start;
    margin-top: var(--space-2);
    margin-bottom: 0;
}
