.store { flex-grow: 1; }
.store__body { flex-direction: column; }

/* The segmented tab row: a sunk track, the active tab lifted to the surface. */
.store__tabs {
    flex-direction: row;
    background-color: var(--surface-sunk);
    border-radius: var(--radius-row);
    padding: var(--space-1);
    margin-bottom: var(--space-3);
}
.store__tab {
    flex-grow: 1; flex-basis: 0;
    margin: 0;
    padding-top: 9px; padding-bottom: 9px;
    padding-left: var(--space-2); padding-right: var(--space-2);
    border-bottom-width: 0;
    border-radius: var(--radius-tile);
    background-color: rgba(0, 0, 0, 0);
    color: var(--mute);
    font-size: var(--text-body);
}
.store__tab:active { translate: 0 0; border-bottom-width: 0; background-color: var(--surface-raised); }
.store__tab--active { background-color: var(--surface); color: var(--violet-text); }

.store__panel { flex-direction: column; }

.store__pack {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2); padding-bottom: var(--space-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--divider);
}
.store__pack-text { flex-direction: column; flex-shrink: 1; }
.store__pack .store__buy {
    flex-shrink: 0;
    margin: 0;
    padding-top: 8px; padding-bottom: 8px;
    padding-left: var(--space-3); padding-right: var(--space-3);
    font-size: var(--text-body);
}

.store__chest-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.store__chest-option { width: 48%; }
