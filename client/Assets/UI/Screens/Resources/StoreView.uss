.store { flex-grow: 1; }
.store__body { flex-direction: column; }

/* The segmented tab row: a sunk track, the active tab lifted to the surface. */
.store__tabs {
    flex-direction: row;
    background-color: var(--surface-sunk);
    border-radius: var(--radius-row);
    padding: var(--space-1);
    margin-bottom: var(--space-3);
}
.store__tab {
    flex-grow: 1; flex-basis: 0;
    margin: 0;
    padding-top: 9px; padding-bottom: 9px;
    padding-left: var(--space-2); padding-right: var(--space-2);
    border-bottom-width: 0;
    border-radius: var(--radius-tile);
    background-color: rgba(0, 0, 0, 0);
    color: var(--ink-secondary);
    font-size: var(--text-body);
}
.store__tab:active { translate: 0 0; border-bottom-width: 0; background-color: var(--surface-raised); }
.store__tab--active { background-color: var(--surface); color: var(--violet-text); }

.store__panel { flex-direction: column; }

.store__gift .section-card__surface {
    background-color: var(--surface-deep);
    border-color: var(--brass);
}
.store__gift .section-card__heading { color: var(--brass-light); }
.store__gift-body { flex-direction: row; align-items: center; margin-bottom: var(--space-2); }
.store__gift-icon {
    width: 38px; height: 38px;
    flex-shrink: 0;
    margin-right: var(--space-3);
    -unity-background-image-tint-color: var(--brass-light);
}
.store__gift-detail { color: var(--surface-paper); font-size: var(--text-body); white-space: normal; }
.store__gift .btn-reward { align-self: flex-start; }

.store__pack {
    flex-direction: column;
    background-color: var(--surface-sunk);
    border-width: 1px;
    border-color: var(--divider);
    border-radius: var(--radius-row);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
}
.store__pack-main { flex-direction: row; align-items: center; }
.store__pack-icon {
    width: 32px; height: 32px;
    flex-shrink: 0;
    margin-right: var(--space-3);
    -unity-background-image-tint-color: var(--brass);
}
.store__pack-text { flex-direction: column; flex-shrink: 1; flex-grow: 1; }
.store__pack-text Label { white-space: normal; }
.store__purchase {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-2);
}
.store__price { color: var(--ink-primary); font-size: var(--text-card-title); -unity-font-style: bold; }
.store__pack .store__buy {
    flex-shrink: 0;
    margin: 0;
    min-height: 44px;
    padding-left: var(--space-2); padding-right: var(--space-2);
    font-size: var(--text-secondary);
}

.store__chest-tiers {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--space-3);
}
.store__chest-tier {
    width: 32%;
    min-height: 44px;
    margin: 0;
    padding: var(--space-2);
    white-space: normal;
    background-color: var(--surface-sunk);
    border-width: 1px;
    border-color: var(--divider);
    border-radius: var(--radius-tile);
    color: var(--ink-secondary);
    font-size: var(--text-secondary);
}
.store__chest-tier--active {
    background-color: var(--violet-tint);
    border-color: var(--violet-light);
    color: var(--violet-text);
}
.store__chest-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.store .store__chest-option {
    width: 48%;
    min-height: 105px;
    padding-left: 38px;
}
.store .store__chest-option .option-row__title,
.store .store__chest-option .option-row__detail { white-space: normal; }
.store__chest-icon {
    position: absolute;
    left: var(--space-2); top: var(--space-3);
    width: 20px; height: 20px;
    -unity-background-image-tint-color: var(--violet-text);
}
.store__chest-summary {
    background-color: var(--surface-deep);
    border-left-width: 3px;
    border-left-color: var(--brass);
    color: var(--surface-paper);
    font-size: var(--text-body);
    white-space: normal;
    padding: var(--space-2);
    margin-bottom: var(--space-2);
}
.store .store__chest-progress {
    color: var(--violet-text);
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
}
.store__pass-card .section-card__surface { border-color: var(--brass); }
